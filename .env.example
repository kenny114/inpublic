# Template only — put real values in .env.local (gitignored).
# Server-side only. Never expose these to the client.
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=

# Optional — only needed if you point BEAT_MODEL / ARTIST_MODEL at a Gemini model.
GEMINI_API_KEY=

# Model selection. Any id starting with "gemini" routes to Google, everything
# else routes to Anthropic. Defaults shown.
BEAT_MODEL=claude-haiku-4-5-20251001
ARTIST_MODEL=claude-sonnet-4-6

# Gemini equivalents, if you'd rather run on Google (both verified working).
# Note gemini-2.5-pro is retired for new API keys — use a 3.x model.
# BEAT_MODEL=gemini-3.6-flash
# ARTIST_MODEL=gemini-3.1-pro-preview

# Which live engine drives the drawing.
#   deepgram : mic -> Deepgram -> /api/scribe (Haiku) -> ops
#   gemini   : mic -> Gemini Live -> draw() tool calls -> ops  (hears you directly)
NEXT_PUBLIC_ENGINE=deepgram
LIVE_MODEL=gemini-3.1-flash-live-preview

# Public community destination. Until this is set, links open discord.com
# rather than inventing an invite that may not exist.
NEXT_PUBLIC_DISCORD_URL=
