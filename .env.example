# Template only — put real values in .env.local (gitignored).
# Server-side only. Never expose these to the client.
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=

# Optional — only needed if you point BEAT_MODEL / ARTIST_MODEL at a Gemini model.
GEMINI_API_KEY=

# Model selection. Any id starting with "gemini" routes to Google, everything
# else routes to Anthropic. Defaults shown.
BEAT_MODEL=claude-haiku-4-5-20251001
ARTIST_MODEL=claude-sonnet-4-6

# Gemini equivalents, if you'd rather run on Google (both verified working).
# Note gemini-2.5-pro is retired for new API keys — use a 3.x model.
# BEAT_MODEL=gemini-3.6-flash
# ARTIST_MODEL=gemini-3.1-pro-preview

# Which live engine drives the drawing.
#   deepgram : mic -> Deepgram -> /api/scribe (Haiku) -> ops
#   gemini   : mic -> Gemini Live -> draw() tool calls -> ops  (hears you directly)
#   moonshine: mic -> local Moonshine bridge (see local/moonshine-bridge) -> ops
NEXT_PUBLIC_ENGINE=deepgram
LIVE_MODEL=gemini-3.1-flash-live-preview

# Moonshine bridge (local/moonshine-bridge/server.py), only used when
# NEXT_PUBLIC_ENGINE=moonshine.
NEXT_PUBLIC_MOONSHINE_BRIDGE_URL=ws://127.0.0.1:8765

# Local-first development stack: set LLM_PROVIDER=ollama to route every LLM
# call (agent decisions, communicator decisions, visual shaping, meaning
# extraction) to a local Ollama server instead of Anthropic/Google, with zero
# remote inference. All BEAT_MODEL/ARTIST_MODEL/etc. selections are ignored
# in that mode — every call uses OLLAMA_MODEL. Requires `ollama serve` running
# and OLLAMA_MODEL pulled (`ollama pull qwen3:4b`). No automatic fallback to a
# paid provider on failure unless OLLAMA_ALLOW_FALLBACK=1 is explicitly set.
LLM_PROVIDER=anthropic
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_ALLOW_FALLBACK=

# Groq-hosted fast inference: set LLM_PROVIDER=groq to route every LLM call
# to Groq's API instead of Anthropic/Google/Ollama. Same all-calls-ignore-
# BEAT_MODEL/ARTIST_MODEL/etc. behavior as LLM_PROVIDER=ollama, but hosted —
# no local server, and calls do leave the machine (they count toward
# getRemoteCallCount()). Requires GROQ_API_KEY. See
# https://console.groq.com/docs/models for available GROQ_MODEL values.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# NVIDIA NIM-hosted inference: set LLM_PROVIDER=nvidia to route every LLM
# call there instead. Same shape as Groq above — hosted, remote, requires
# NVIDIA_API_KEY. See https://build.nvidia.com/models for available
# NVIDIA_MODEL values.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# When LLM_PROVIDER is groq or nvidia, a request that is still rate-limited
# after that provider's own retry-with-backoff normally just fails. Setting
# the matching flag to 1 lets it fail over to the other hosted provider
# instead (requires that provider's API key to also be set), the same
# opt-in shape as OLLAMA_ALLOW_FALLBACK.
GROQ_ALLOW_FALLBACK=
NVIDIA_ALLOW_FALLBACK=

# Math Explanation System and Audio Replay Mode. Both off by default —
# Standard/Story mode behavior is unchanged either way. Math mode adds one
# possible Beat decision (math_step) and a new /api/math route; Audio Replay
# adds an upload panel and a new /api/audio/upload route. See
# docs/math-reasoning-schema.md and docs/audio-timeline-schema.md.
NEXT_PUBLIC_ENABLE_MATH_MODE=false
NEXT_PUBLIC_ENABLE_AUDIO_REPLAY=false
# Defaults to ARTIST_MODEL if unset, so no new provider_rate_cards row is needed.
MATH_MODEL=

# Public community destination. Until this is set, links open discord.com
# rather than inventing an invite that may not exist.
NEXT_PUBLIC_DISCORD_URL=
NEXT_PUBLIC_SITE_URL=

# Supabase Auth + Postgres. The publishable key is safe for the browser because
# RLS is the authorization boundary. The service role is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Whop sandbox/test credentials and the approved $15 Creator renewal plan.
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
# Use https://sandbox-api.whop.com/api/v1 in sandbox. Leave unset in production.
WHOP_BASE_URL=
WHOP_COMPANY_ID=
WHOP_CREATOR_PLAN_ID=
NEXT_PUBLIC_WHOP_APP_ID=

# Comma-separated, exact email allowlist for /admin/costs and emergency-stop API.
ADMIN_EMAIL_ALLOWLIST=
RATE_LIMIT_HASH_SECRET=

# Atomic provider limits. Defaults are used when omitted.
RATE_LIMIT_DEEPGRAM_TOKENS=3
RATE_LIMIT_GEMINI_TOKENS=3
RATE_LIMIT_SCRIBE_PER_MINUTE=12
RATE_LIMIT_BEAT_PER_MINUTE=10
RATE_LIMIT_ARTIST_PER_MINUTE=6
RATE_LIMIT_STORY_PER_MINUTE=8
RATE_LIMIT_MATH_PER_MINUTE=6
RATE_LIMIT_AUDIO_PER_MINUTE=4
RATE_LIMIT_AUTH_IP_PER_15_MINUTES=20
RATE_LIMIT_AUTH_EMAIL_PER_15_MINUTES=8
USAGE_LEASE_SECONDS=30
USAGE_MAX_GLOBAL_CONCURRENT_SESSIONS=100
NEXT_PUBLIC_BACKGROUND_PAUSE_SECONDS=30

# Conservative launch defaults. Kenny must choose and monitor production values.
COST_MAX_USER_DAILY_USD=0.75
COST_MAX_USER_PERIOD_USD=8
COST_MAX_GLOBAL_HOURLY_USD=5
COST_MAX_GLOBAL_DAILY_USD=25
COST_MAX_GLOBAL_MONTHLY_USD=250
COST_MAX_ARTIST_SESSION_USD=0.50
COST_MAX_PROVIDER_CALLS_PER_SESSION=500
